<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=mscorlib"
 Title="What the Port" Language="en-US" KeyboardNavigation.TabNavigation="Cycle" Width="440" Height="594" MinWidth="344" MinHeight="460" WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" Topmost="True" FontFamily="Segoe UI" FontSize="13" Foreground="#F5F5F7" UseLayoutRounding="True" SnapsToDevicePixels="True">
 <Window.Resources>
  <sys:Double x:Key="ControlHitSize">30</sys:Double>
  <sys:Double x:Key="ButtonMinHeight">32</sys:Double>
  <sys:Double x:Key="InputMinHeight">34</sys:Double>
  <SolidColorBrush x:Key="Muted" Color="#A4A6AF"/>
  <Style x:Key="Switch" TargetType="ToggleButton">
   <Setter Property="AutomationProperties.AutomationId" Value="{Binding Tag, RelativeSource={RelativeSource Self}, TargetNullValue={x:Static sys:String.Empty}}"/>
   <Setter Property="MinHeight" Value="{DynamicResource ControlHitSize}"/>
   <Setter Property="Width" Value="44"/><Setter Property="Height" Value="30"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
    <Grid Background="Transparent"><Border x:Name="Track" Height="22" CornerRadius="11" Background="#454852" BorderBrush="#858995" BorderThickness="1"/>
     <Ellipse x:Name="Thumb" Width="16" Height="16" Fill="#F5F5F7" HorizontalAlignment="Left" Margin="4,0"/>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#3C7278"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="#7DDBE0"/><Setter TargetName="Track" Property="BorderThickness" Value="2"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Button">
   <Setter Property="AutomationProperties.AutomationId" Value="{Binding Tag, RelativeSource={RelativeSource Self}, TargetNullValue={x:Static sys:String.Empty}}"/>
   <Setter Property="Foreground" Value="#F5F5F7"/><Setter Property="Background" Value="#2D3039"/>
   <Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,7"/>
   <Setter Property="Cursor" Value="Hand"/><Setter Property="MinHeight" Value="{DynamicResource ButtonMinHeight}"/>
   <Setter Property="HorizontalContentAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Grid><Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
    </Border><Border x:Name="ButtonFocus" BorderBrush="Transparent" BorderThickness="2" CornerRadius="7" IsHitTestVisible="False"/></Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.76"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.55"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonFocus" Property="BorderBrush" Value="#7DDBE0"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.35"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="AutomationProperties.AutomationId" Value="{Binding Tag, RelativeSource={RelativeSource Self}, TargetNullValue={x:Static sys:String.Empty}}"/>
   <Setter Property="Foreground" Value="#F5F5F7"/><Setter Property="Background" Value="#292D36"/><Setter Property="BorderBrush" Value="#727989"/>
   <Setter Property="Padding" Value="9,7"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CaretBrush" Value="White"/>
   <Setter Property="SelectionBrush" Value="#586CAA"/>
   <Setter Property="MinHeight" Value="{DynamicResource InputMinHeight}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}"><ScrollViewer x:Name="PART_ContentHost" Style="{x:Null}"/></Border></ControlTemplate></Setter.Value></Setter>
   <Style.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="#7DDBE0"/></Trigger></Style.Triggers>
  </Style>
  <Style TargetType="CheckBox">
   <Setter Property="AutomationProperties.AutomationId" Value="{Binding Tag, RelativeSource={RelativeSource Self}, TargetNullValue={x:Static sys:String.Empty}}"/>
   <Setter Property="MinHeight" Value="{DynamicResource ControlHitSize}"/>
   <Setter Property="Foreground" Value="#F5F5F7"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
    <Grid Background="Transparent"><StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <Border x:Name="CheckBorder" Width="17" Height="17" BorderThickness="1" BorderBrush="#757986" CornerRadius="5" Background="#252A34" VerticalAlignment="Center"><TextBlock x:Name="Tick" Text="✓" Visibility="Collapsed" FontSize="13" Foreground="#17191E" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
     <ContentPresenter x:Name="CheckContent" Margin="10,0,0,0" VerticalAlignment="Center"/>
    </StackPanel></Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="Content" Value="{x:Null}"><Setter TargetName="CheckContent" Property="Margin" Value="0"/></Trigger>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="CheckBorder" Property="Background" Value="#F5F5F7"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="CheckBorder" Property="Opacity" Value="0.35"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CheckBorder" Property="BorderBrush" Value="#7DDBE0"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBoxItem">
   <Setter Property="MinHeight" Value="{DynamicResource ControlHitSize}"/>
   <Setter Property="Foreground" Value="#F5F5F7"/><Setter Property="Padding" Value="10,8"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="ItemBorder" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="4"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#434B5F"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="AutomationProperties.AutomationId" Value="{Binding Tag, RelativeSource={RelativeSource Self}, TargetNullValue={x:Static sys:String.Empty}}"/>
   <Setter Property="MinHeight" Value="{DynamicResource InputMinHeight}"/><Setter Property="Foreground" Value="#F5F5F7"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
    <Grid>
     <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ClickMode="Press">
      <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="SelectBorder" Background="#292D36" BorderBrush="#727989" BorderThickness="1" CornerRadius="6"><TextBlock Text="⌄" Foreground="#B7BAC4" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,3"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SelectBorder" Property="BorderBrush" Value="#7DDBE0"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
     </ToggleButton>
     <ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="10,6,30,6" VerticalAlignment="Center"/>
     <Border x:Name="SelectFocus" IsHitTestVisible="False" BorderBrush="Transparent" BorderThickness="2" CornerRadius="6"/>
     <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
      <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Background="#292D36" BorderBrush="#59606F" BorderThickness="1" CornerRadius="6" Padding="4" Margin="0,3,0,0"><StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/></Border>
     </Popup>
    </Grid>
    <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="SelectFocus" Property="BorderBrush" Value="#7DDBE0"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ToolTip">
   <Setter Property="Background" Value="#292E38"/><Setter Property="Foreground" Value="#F5F5F7"/><Setter Property="BorderBrush" Value="#59606F"/>
   <Setter Property="MaxWidth" Value="340"/><Setter Property="Padding" Value="12,10"/><Setter Property="FontSize" Value="12"/>
   <Setter Property="FontFamily" Value="{DynamicResource ToolTipFont}"/><Setter Property="HorizontalContentAlignment" Value="Left"/>
   <Setter Property="ContentTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding Converter={StaticResource ToolTipText}}" TextAlignment="Left" TextWrapping="Wrap" TextTrimming="None" LineHeight="18"/></DataTemplate></Setter.Value></Setter>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToolTip"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Content"/></Border></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ScrollBar">
   <Setter Property="Width" Value="5"/><Setter Property="MinWidth" Value="0"/><Setter Property="MaxWidth" Value="5"/><Setter Property="Background" Value="Transparent"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
    <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
     <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
     <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#59606F" CornerRadius="3" Margin="0,3"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
     <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
    </Track>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ScrollViewer"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollViewer">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" ClipToBounds="True" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" CanContentScroll="{TemplateBinding CanContentScroll}"/>
    <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Width="5" MinWidth="0" MaxWidth="5" Margin="0,0,3,0" Orientation="Vertical" Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}" Value="{Binding VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
   </Grid>
  </ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Border x:Name="PanelBackground" CornerRadius="17" BorderThickness="1" BorderBrush="#53555E" Padding="0,0,0,1">
  <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0.5,1"><GradientStop Color="#15171C" Offset="0"/><GradientStop Color="#1C2029" Offset="0.58"/><GradientStop Color="#242B39" Offset="1"/></LinearGradientBrush></Border.Background>
  <DockPanel LastChildFill="True">
   <Grid x:Name="Header" KeyboardNavigation.TabIndex="0" DockPanel.Dock="Top" Height="54" Margin="14,0">
    <Grid.ColumnDefinitions><ColumnDefinition Width="66"/><ColumnDefinition Width="*"/><ColumnDefinition Width="66"/></Grid.ColumnDefinitions>
    <Button x:Name="Back" Height="32" Width="32" HorizontalAlignment="Left" VerticalAlignment="Center" Tag="header-back" AutomationProperties.Name="Back to servers" Content="‹" FontSize="25" Padding="0" Background="Transparent" ToolTip="Back (Esc)"/>
    <TextBlock x:Name="Title" Grid.Column="1" Text="What the Port" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Stretch" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
    <Button x:Name="Pin" Height="32" Width="32" HorizontalAlignment="Right" Margin="0,0,34,0" VerticalAlignment="Center" Tag="header-pin" AutomationProperties.Name="Keep panel open" Grid.Column="2" Content="◇" Background="Transparent" Padding="0" ToolTip="Keep panel open"/>
    <Button x:Name="Hide" Height="32" Width="32" HorizontalAlignment="Right" VerticalAlignment="Center" Tag="header-hide" AutomationProperties.Name="Hide to tray" Grid.Column="2" Content="×" Background="Transparent" FontSize="19" Padding="0" ToolTip="Hide to tray (Esc)"/>
   </Grid>
   <StackPanel x:Name="Summary" DockPanel.Dock="Top" Margin="16,0,16,12"/>
   <StackPanel KeyboardNavigation.TabIndex="2" DockPanel.Dock="Bottom">
    <Border x:Name="MessageBox" Background="#36312B" Padding="12,9" Margin="12,4" CornerRadius="7" Visibility="Collapsed"><TextBlock x:Name="Message" AutomationProperties.LiveSetting="Polite" Foreground="#FFCF83" FontSize="11" TextWrapping="Wrap"/></Border>
    <Border BorderBrush="#30343D" BorderThickness="0,1,0,0"><StackPanel x:Name="Footer" Margin="12,11,12,8"/></Border>
    <TextBlock x:Name="Status" Margin="20,0,20,10" Foreground="#979DAA" FontSize="10"/>
   </StackPanel>
   <ScrollViewer x:Name="Scroll" KeyboardNavigation.TabIndex="1" Style="{StaticResource {x:Type ScrollViewer}}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"><StackPanel x:Name="Body" Margin="16,0,16,12"/></ScrollViewer>
  </DockPanel>
 </Border>
</Window>
